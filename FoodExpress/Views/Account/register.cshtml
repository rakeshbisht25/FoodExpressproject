@model FoodExpress.Models.RegisterModel

<h2>Register</h2>

<form asp-action="Register">
    <div asp-validation-summary="All"
         class="text-danger">
    </div>
    <div class="mb-3">
        <label>Email</label>
        <input asp-for="Email"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <input asp-for="Password"
               type="password"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Confirm Password</label>
        <input asp-for="ConfirmPassword"
               type="password"
               class="form-control" />
    </div>

    <button class="btn btn-success">
        Register
    </button>

</form>